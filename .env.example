# ==============================================================
# Century 21 Inova - Panel Administrativo
# Variables de entorno requeridas. Copia este archivo a ".env.local"
# y completa los valores. Ninguna de estas variables debe usar el
# prefijo NEXT_PUBLIC_: todas se consumen exclusivamente en el
# servidor (Server Components, Server Actions y Route Handlers).
# ==============================================================

# --- Auth.js (autenticación) ---------------------------------
# Clave secreta usada para firmar las sesiones JWT.
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# Contraseña única compartida para entrar al panel (sin cuentas
# individuales). Cualquiera que la conozca entra con rol ADMIN.
AUTH_PASSWORD=

# URL pública del sitio (usada por Auth.js para construir callbacks).
AUTH_URL=http://localhost:3000

# --- Google Sheets (Google Cloud Service Account) --------------
# Crear una cuenta de servicio en Google Cloud Console con acceso
# de "Editor" y compartir el Google Sheet con su correo.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
# Pega la clave privada completa, incluyendo las líneas
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY-----.
# Si tu proveedor de hosting no admite saltos de línea reales en
# variables de entorno, reemplázalos por "\n"; lib/env.ts los normaliza.
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# --- Make (automatización) ---------------------------------------
# Secreto compartido que Make debe enviar en el header "x-inova-secret"
# al llamar a POST /api/integrations/make/events y también a
# POST /api/integrations/make/select-advisor (mismo secreto, mismo header;
# no se agregó una variable nueva para este endpoint).
MAKE_WEBHOOK_SECRET=

# URL del webhook de Make que el panel invoca para disparar una
# sincronización manual (botón "Ejecutar sincronización").
MAKE_SYNC_WEBHOOK_URL=

# --- Modo demostración -------------------------------------------
# Por defecto (variable vacía o sin definir) el modo demostración está
# ACTIVO: quita el login por contraseña (todo visitante entra como ADMIN)
# y fuerza los datos sembrados de lib/demo-data.ts aunque Google Sheets o la
# base de datos estén configurados. Pon DEMO_MODE=false cuando quieras
# activar el login real y los datos reales.
DEMO_MODE=

# ==============================================================
# Neon PostgreSQL + Prisma (nuevo backend, ver docs/MIGRATION_TO_DATABASE.md)
# ==============================================================

# Cadena de conexión de Neon (Postgres). Prisma 7 la usa tanto para
# migraciones (prisma.config.ts) como en runtime, a través del driver
# adapter @prisma/adapter-neon (lib/db.ts) — nunca se lee desde
# prisma/schema.prisma directamente.
DATABASE_URL=

# Fuente de datos que leen las pantallas del panel: "database" (Postgres,
# el nuevo destino) o "sheets" (legado). Vacío/no definido = "sheets", para
# que agregar Prisma no cambie nada hasta que decidas migrar de verdad.
# DEMO_MODE tiene prioridad sobre esta variable: si DEMO_MODE está activo,
# ninguna de las dos fuentes se toca. Ver lib/env.ts (getDataSource).
# Pon DATA_SOURCE=database cuando quieras que el panel lea Postgres.
DATA_SOURCE=

# Modo del motor de automatización de leads (webhooks nuevos de ManyChat):
# "shadow" (por defecto si está vacío) simula todo sin llamar a EasyBroker
# ni a ManyChat de verdad; "live" ejecuta las llamadas reales. Cámbialo solo
# en la configuración de variables de entorno del hosting (Vercel), nunca
# desde la UI del panel.
AUTOMATION_MODE=shadow

# --- EasyBroker ----------------------------------------------------
EASYBROKER_API_KEY=

# Correo "comodín" que EasyBroker devuelve como agente de una propiedad sin
# asesor dedicado — esos leads caen en la ruleta ponderada en vez de
# asignación directa. Por defecto contacto@c21inova.com si se deja vacío.
EASYBROKER_FALLBACK_AGENT_EMAIL=contacto@c21inova.com

# --- ManyChat --------------------------------------------------------
MANYCHAT_API_KEY=

# ID del flow de ManyChat que notifica al asesor asignado.
MANYCHAT_ADVISOR_FLOW_ID=

# --- OpenAI (búsqueda profunda de propiedades) ------------------------
OPENAI_API_KEY=

# Modelo a usar para el matching de propiedades. Sin valor por defecto a
# propósito: pon aquí el modelo que tu cuenta de OpenAI tenga disponible
# (el scenario de Make original usaba "gpt-5.4-mini", pero eso depende de
# tu acceso, no lo asumas).
OPENAI_PROPERTY_SEARCH_MODEL=

# --- Webhooks/endpoints nuevos -----------------------------------------
# Secreto compartido para los endpoints nuevos bajo /api/webhooks/* y
# /api/admin/* (header "x-inova-secret", igual patrón que MAKE_WEBHOOK_SECRET
# pero para el backend propio en vez de Make).
INTEGRATION_SECRET=

# Secreto para cualquier tarea programada (Vercel Cron) que se agregue más
# adelante (reintentos pendientes, limpieza de WebhookEvent, etc.).
CRON_SECRET=

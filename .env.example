# ==============================================================
# Century 21 Inova - Panel Administrativo
# Variables de entorno requeridas. Copia este archivo a ".env.local"
# y completa los valores. Ninguna de estas variables debe usar el
# prefijo NEXT_PUBLIC_: todas se consumen exclusivamente en el
# servidor (Server Components, Server Actions y Route Handlers).
# ==============================================================

# --- Auth.js (autenticación) ---------------------------------
# Clave secreta usada para firmar las sesiones JWT.
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# Contraseña única compartida para entrar al panel (sin cuentas
# individuales). Cualquiera que la conozca entra con rol ADMIN.
AUTH_PASSWORD=

# URL pública del sitio (usada por Auth.js para construir callbacks).
AUTH_URL=http://localhost:3000

# --- Google Sheets (Google Cloud Service Account) --------------
# Crear una cuenta de servicio en Google Cloud Console con acceso
# de "Editor" y compartir el Google Sheet con su correo.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
# Pega la clave privada completa, incluyendo las líneas
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY-----.
# Si tu proveedor de hosting no admite saltos de línea reales en
# variables de entorno, reemplázalos por "\n"; lib/env.ts los normaliza.
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# --- EasyBroker --------------------------------------------------
EASYBROKER_API_KEY=

# --- Make (automatización) ---------------------------------------
# Secreto compartido que Make debe enviar en el header "x-inova-secret"
# al llamar a POST /api/integrations/make/events y también a
# POST /api/integrations/make/select-advisor (mismo secreto, mismo header;
# no se agregó una variable nueva para este endpoint).
MAKE_WEBHOOK_SECRET=

# URL del webhook de Make que el panel invoca para disparar una
# sincronización manual (botón "Ejecutar sincronización").
MAKE_SYNC_WEBHOOK_URL=

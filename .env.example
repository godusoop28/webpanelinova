# ==============================================================
# Century 21 Inova - Panel Administrativo
# Variables de entorno requeridas. Copia este archivo a ".env.local"
# y completa los valores. Ninguna debe usar el prefijo NEXT_PUBLIC_:
# todas se consumen exclusivamente en el servidor.
# ==============================================================

# --- Auth (sesión del panel) --------------------------------------
# Clave secreta usada para firmar las sesiones JWT.
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# URL pública del sitio (usada por Auth.js para construir callbacks).
AUTH_URL=http://localhost:3000

# --- Base de datos (Neon PostgreSQL + Prisma) ----------------------
DATABASE_URL=

# --- EasyBroker ------------------------------------------------------
EASYBROKER_API_KEY=

# Correo "comodín" que EasyBroker devuelve como agente de una propiedad
# sin asesor dedicado — esos leads caen en la ruleta ponderada en vez
# de asignación directa. Por defecto contacto@c21inova.com si se deja vacío.
EASYBROKER_FALLBACK_AGENT_EMAIL=contacto@c21inova.com

# --- ManyChat ----------------------------------------------------------
MANYCHAT_API_KEY=

# ID del flow de ManyChat que notifica al asesor asignado.
MANYCHAT_ADVISOR_FLOW_ID=

# --- OpenAI (búsqueda profunda de propiedades) --------------------------
OPENAI_API_KEY=

# Modelo a usar para el matching de propiedades. Sin valor por defecto a
# propósito: pon el modelo que tu cuenta de OpenAI tenga disponible.
OPENAI_PROPERTY_SEARCH_MODEL=

# --- Seguridad de webhooks/API interna -----------------------------------
# Secreto compartido para /api/webhooks/* (ManyChat, header "x-inova-secret")
# y para los endpoints administrativos.
INTEGRATION_SECRET=

# Secreto para el endpoint de reintentos programados (Vercel Cron).
CRON_SECRET=

# --- Modo de automatización ------------------------------------------------
# "shadow" (por defecto si se deja vacío) simula todo el pipeline de leads
# sin llamar de verdad a EasyBroker ni ManyChat; "live" ejecuta las llamadas
# reales. Cámbialo solo en las variables de entorno del hosting, nunca desde
# el panel.
AUTOMATION_MODE=shadow

# --- Seed inicial (solo para sembrar el primer usuario ADMIN) --------------
# Usadas únicamente por `npm run db:seed`. No quedan en la base como texto
# plano: el seed genera el hash y descarta el valor.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Opcional / desarrollo --------------------------------------------------
# Habilita la página interna /testing (simulador de leads en modo shadow).
# Debe quedar en "false" o vacío en producción normal.
ENABLE_INTERNAL_TESTING=false

// Century 21 Inova - Panel Administrativo
// Modelo multiempresa: Century 21 Innova es la primera Company, pero ningún
// modelo asume que es la única (ver docs/MIGRATION_TO_DATABASE.md).

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (CLI) and lib/db.ts (runtime,
// via the @prisma/adapter-neon driver adapter) — Prisma 7 no longer reads
// `url` from this block. See docs/MIGRATION_TO_DATABASE.md.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DIRECCION
  CONSULTA
}

enum LeadInterestType {
  PROPERTY
  EXPLORE
  CAMPAIGN
  TIMEOUT
  NO_RESPONSE
  OTHER
}

enum LeadStatus {
  RECEIVED
  PROCESSING
  CREATED_IN_EASYBROKER
  ASSIGNED
  NOTIFIED
  COMPLETED
  FAILED
}

enum AssignmentStatus {
  PENDING
  ASSIGNED
  CONFIRMED
  FAILED
}

enum AssignmentMethod {
  DIRECT_PROPERTY_ADVISOR
  WEIGHTED_ROTATION
  CAMPAIGN_DIRECT
  MANUAL
  FALLBACK
}

enum IntegrationType {
  EASYBROKER
  MANYCHAT
  OPENAI
}

enum IntegrationJobType {
  EASYBROKER_CREATE
  EASYBROKER_ASSIGN
  MANYCHAT_FIELDS
  MANYCHAT_FLOW
}

enum IntegrationJobStatus {
  PENDING
  RETRYING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// Multiempresa
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  advisors         Advisor[]
  leads            Lead[]
  assignmentRules  AssignmentRule[]
  integrations     Integration[]
  auditLogs        AuditLog[]
  integrationJobs  IntegrationJob[]
  conversations     Conversation[]
  escalations       ConversationEscalation[]
  assistantSettings AssistantSettings?
  propertyCache     PropertyCacheEntry[]

  @@map("companies")
}

/** Autenticación real del panel: email + passwordHash (bcrypt), ver lib/auth.ts. */
model User {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(CONSULTA)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Asesores
// ---------------------------------------------------------------------------

model Advisor {
  id                   String    @id @default(cuid())
  companyId            String
  name                 String
  email                String?
  phone                String
  easyBrokerEmail      String?
  easyBrokerAgentId    String?
  manyChatSubscriberId String?
  active               Boolean   @default(true)
  weight               Int       @default(5)
  dailyLimit           Int?
  pausedUntil          DateTime?
  /** Cache del conteo del día; la verdad se calcula desde LeadAssignment (ver lib/services/assignment.service.ts). */
  leadsToday           Int       @default(0)
  allowedProperty      Boolean   @default(true)
  allowedExplore       Boolean   @default(true)
  allowedCampaign      Boolean   @default(true)
  allowedTimeout       Boolean   @default(true)
  priority             Int?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  assignments LeadAssignment[]
  leads       Lead[]           @relation("LeadAssignedAdvisor")
  auditLogs   AuditLog[]

  @@unique([companyId, easyBrokerEmail])
  @@index([companyId])
  @@index([active])
  @@index([easyBrokerEmail])
  @@map("advisors")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id        String           @id @default(cuid())
  companyId String
  name      String
  phone     String

  interestType LeadInterestType @default(OTHER)
  /** Texto crudo enviado por el cliente (ID de propiedad, referencia de campaña, etc). */
  propertyData String?
  /** Campo de negocio: de dónde vino el lead (p. ej. "WhatsApp ManyChat"). */
  origin       String?
  /** Etiqueta de ruta usada por el motor de asignación (p. ej. "Vi una propiedad"). */
  route        String?
  status       LeadStatus       @default(RECEIVED)
  /** Procedencia técnica del registro: manychat_webhook, import_historico, testing_ui. */
  source       String?

  easyBrokerContactRequestId String?
  easyBrokerContactId        String?
  easyBrokerPropertyId       String?

  manyChatSubscriberId String?

  assignedAdvisorId String?
  assignmentStatus  AssignmentStatus @default(PENDING)

  /** Clave de idempotencia: la de ManyChat si viene, o un fingerprint determinístico. */
  requestId String? @unique

  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  assignedAdvisor Advisor?         @relation("LeadAssignedAdvisor", fields: [assignedAdvisorId], references: [id])
  assignments     LeadAssignment[]
  auditLogs       AuditLog[]
  integrationJobs IntegrationJob[]
  conversations   Conversation[]

  @@index([phone])
  @@index([createdAt])
  @@index([status])
  @@index([companyId])
  @@index([assignedAdvisorId])
  /** Every report/dashboard query filters by companyId + a createdAt range — this is the one that matters for multi-month reports. */
  @@index([companyId, createdAt])
  @@map("leads")
}

model LeadAssignment {
  id     String @id @default(cuid())
  leadId String
  advisorId String

  method             AssignmentMethod
  weightAtAssignment Int
  reason             String?
  status             AssignmentStatus @default(PENDING)
  easyBrokerConfirmed Boolean         @default(false)
  manyChatNotified    Boolean         @default(false)
  assignedAt          DateTime        @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id])
  advisor Advisor @relation(fields: [advisorId], references: [id])

  @@index([leadId])
  @@index([advisorId])
  @@index([assignedAt])
  @@map("lead_assignments")
}

model AssignmentRule {
  id        String  @id @default(cuid())
  companyId String
  name      String
  active    Boolean @default(true)
  route     String

  minimumWeight     Int?
  maximumDailyLeads Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("assignment_rules")
}

// ---------------------------------------------------------------------------
// Integraciones (configuración no sensible; los secretos siguen en ENV)
// ---------------------------------------------------------------------------

model Integration {
  id        String          @id @default(cuid())
  companyId String
  type      IntegrationType
  active    Boolean         @default(true)
  /** Configuración NO sensible (IDs de flow, nombres, límites). Nunca secretos. */
  config    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, type])
  @@map("integrations")
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  leadId    String?
  advisorId String?

  eventType String
  status    String
  message   String?
  metadata  Json?

  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  advisor Advisor? @relation(fields: [advisorId], references: [id])

  @@index([createdAt])
  @@index([leadId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Reintentos ante fallos de integraciones externas
// ---------------------------------------------------------------------------

model IntegrationJob {
  id        String @id @default(cuid())
  companyId String
  leadId    String?

  type    IntegrationJobType
  status  IntegrationJobStatus @default(PENDING)
  payload Json

  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead?   @relation(fields: [leadId], references: [id])

  @@index([status, nextRetryAt])
  @@index([leadId])
  @@map("integration_jobs")
}

model WebhookEvent {
  id         String  @id @default(cuid())
  provider   String
  externalId String?
  eventType  String
  payload    Json
  status     String  @default("received")

  processingAttempts Int       @default(0)
  processedAt         DateTime?
  lastError            String?

  createdAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([externalId])
  @@index([createdAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Asistente conversacional (WhatsApp vía ManyChat)
// Ver docs/CONVERSATIONAL_ASSISTANT.md. ManyChat solo transporta mensajes:
// memoria, reglas y decisiones viven aquí.
// ---------------------------------------------------------------------------

/** OFF: el backend guarda mensajes pero no contesta (ManyChat cae al flujo anterior). TEST_ONLY: solo contactos de prueba. ON: todos. */
enum AssistantMode {
  OFF
  TEST_ONLY
  ON
}

/** Quién controla la conversación en el número del bot. Independiente de la asignación comercial. */
enum ConversationControl {
  AI
  HUMAN
  PAUSED
}

/** Estado de la canalización comercial (lead + asesor), separado del control de la conversación. */
enum ConversationHandoffState {
  NONE
  ASSIGNED
  EXISTING_LEAD
  NO_ADVISOR
  FAILED
  NOT_APPLICABLE
}

enum ConversationIntent {
  UNKNOWN
  PROPERTY_INQUIRY
  BUY
  RENT
  SELL
  LEASE_OUT
  INVEST
  AGENT_COLLABORATION
  PROVIDER
  MANAGEMENT
  HUMAN_REQUEST
  OTHER
}

enum ConversationMessageRole {
  USER
  ASSISTANT
  HUMAN_AGENT
  SYSTEM
}

/** Salientes: QUEUED → SENDING → SENT | FAILED | UNCERTAIN (timeout: el proveedor pudo haberlo aceptado). SIMULATED: nunca se envía. */
enum ConversationMessageStatus {
  RECEIVED
  QUEUED
  SENDING
  SENT
  FAILED
  UNCERTAIN
  CANCELLED
  SIMULATED
}

enum ConversationTurnStatus {
  RUNNING
  COMPLETED
  SUPERSEDED
  FAILED
}

enum EscalationType {
  MANAGEMENT
  HUMAN
  FOLLOW_UP
  PROCESSING_ERROR
}

enum EscalationStatus {
  PENDING
  NOTIFIED
  RESOLVED
}

model AssistantSettings {
  id                      String        @id @default(cuid())
  companyId               String        @unique
  mode                    AssistantMode @default(OFF)
  /** Silencio que cierra una ráfaga de mensajes antes de interpretarla. */
  debounceSeconds         Int           @default(6)
  /** Tope: una ráfaga continua no pospone la respuesta más allá de esto. */
  maxWaitSeconds          Int           @default(25)
  /** Aclaraciones sin progreso antes de ofrecer/realizar atención humana. */
  maxClarifications       Int           @default(3)
  /** Minutos sin respuesta (con interés inmobiliario confirmado) antes de canalizar lo disponible. 0 = nunca. */
  abandonHandoffMinutes   Int           @default(30)
  /** Un lead de este teléfono dentro de esta ventana se reutiliza: no se reasigna. */
  existingLeadWindowDays  Int           @default(30)
  /** Subscriber IDs de ManyChat autorizados para pruebas (modo TEST_ONLY). */
  testSubscriberIds       String[]      @default([])
  /** Subscriber IDs de ManyChat de gerencia; vacío = los pendientes quedan solo en el panel. */
  managementSubscriberIds String[]      @default([])
  updatedBy               String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("assistant_settings")
}

model Conversation {
  id                   String  @id @default(cuid())
  companyId            String
  channel              String  @default("whatsapp")
  manyChatSubscriberId String
  phone                String?
  name                 String?
  /** Simulación o contacto de prueba: nunca crea leads ni asignaciones reales. */
  isTest               Boolean @default(false)

  control          ConversationControl @default(AI)
  controlReason    String?
  controlChangedAt DateTime?
  controlChangedBy String?

  handoffState  ConversationHandoffState @default(NONE)
  handoffReason String?
  handoffAt     DateTime?
  leadId        String?

  primaryIntent      ConversationIntent   @default(UNKNOWN)
  secondaryIntents   ConversationIntent[] @default([])
  /** Requisitos: { campo: { value, status: "known" | "declined" } } — ausencia = desconocido. */
  facts              Json?
  /** Propiedades mencionadas: [{ publicId, verified, title, url, source }]. */
  properties         Json?
  missingData        String[]             @default([])
  summary            String?
  clarificationCount Int                  @default(0)
  /** Atribución de campaña/origen (se conserva aunque la intención sea otra). */
  campaignRef        String?

  // --- Procesamiento persistente ---
  lastSeq             Int       @default(0)
  /** Último mensaje entrante incorporado a un turno completado. */
  processedSeq        Int       @default(0)
  burstStartedAt      DateTime?
  processAfter        DateTime?
  leaseOwner          String?
  leaseUntil          DateTime?
  consecutiveFailures Int       @default(0)
  lastError           String?

  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id])
  lead        Lead?                    @relation(fields: [leadId], references: [id])
  messages    ConversationMessage[]
  turns       ConversationTurn[]
  escalations ConversationEscalation[]

  @@unique([companyId, channel, manyChatSubscriberId])
  @@index([companyId, lastActivityAt])
  @@index([companyId, phone])
  @@index([processAfter])
  @@map("conversations")
}

model ConversationMessage {
  id             String                    @id @default(cuid())
  conversationId String
  companyId      String
  seq            Int
  role           ConversationMessageRole
  text           String
  status         ConversationMessageStatus
  /** Clave de deduplicación de la entrega (ID del canal o huella estable); null = sin dedupe posible. */
  dedupeKey      String?
  turnId         String?
  attempts       Int                       @default(0)
  lastError      String?
  sentAt         DateTime?
  metadata       Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, seq])
  @@unique([conversationId, dedupeKey])
  @@index([status])
  @@map("conversation_messages")
}

/** Traza de cada interpretación: herramientas usadas y consumo, sin razonamiento del modelo ni secretos. */
model ConversationTurn {
  id             String                 @id @default(cuid())
  conversationId String
  fromSeq        Int
  toSeq          Int
  status         ConversationTurnStatus @default(RUNNING)
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  toolCalls      Json?
  error          String?
  durationMs     Int?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("conversation_turns")
}

model ConversationEscalation {
  id             String           @id @default(cuid())
  companyId      String
  conversationId String
  type           EscalationType
  status         EscalationStatus @default(PENDING)
  reason         String
  notifiedAt     DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company      Company      @relation(fields: [companyId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([companyId, status])
  @@index([conversationId])
  @@map("conversation_escalations")
}

/** Índice local del inventario publicado de EasyBroker. La verdad sigue en EasyBroker: se consulta el detalle antes de afirmar datos. */
model PropertyCacheEntry {
  id           String   @id @default(cuid())
  companyId    String
  publicId     String
  title        String
  propertyType String?
  location     String?
  operations   Json?
  bedrooms     Int?
  bathrooms    Float?
  publicUrl    String?
  searchText   String
  ebUpdatedAt  String?
  published    Boolean  @default(true)
  syncedAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, publicId])
  @@index([companyId, published])
  @@map("property_cache")
}
